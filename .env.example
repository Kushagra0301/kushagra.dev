# Public origin, used for canonical links, the sitemap and OG metadata.
#
# Either set this to a real URL or leave it out entirely — do NOT declare it
# with a blank value in a hosting dashboard. An empty string is not the same
# as unset, and content/site.ts now skips unusable values rather than trusting
# them. If this is absent, Vercel's own project URL is used, then a fallback.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form delivery. Set ONE of the two. ---
#
# Web3Forms (https://web3forms.com) — no domain verification needed.
#
# Must be NEXT_PUBLIC_: Web3Forms' API is behind Cloudflare bot protection
# that rejects server-to-server calls, so the browser submits directly and the
# key is necessarily public. That is true of every Web3Forms integration; the
# key only permits submitting to this one form. Rotate it if it gets abused.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Resend (https://resend.com) — used only if WEB3FORMS_ACCESS_KEY is unset.
# Needs a verified sending domain.
RESEND_API_KEY=

# Resend only. Verified sender; falls back to the Resend onboarding address.
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"

# Resend only. Where enquiries land; defaults to the email in content/site.ts.
CONTACT_TO_EMAIL=
