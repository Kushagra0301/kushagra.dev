# Public site URL, used for canonical links, sitemap and OG metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend (https://resend.com) — required for the contact form to deliver mail.
RESEND_API_KEY=

# Verified sender. Falls back to Resend onboarding address if unset.
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"

# Where enquiries land. Defaults to the email in content/site.ts.
CONTACT_TO_EMAIL=
